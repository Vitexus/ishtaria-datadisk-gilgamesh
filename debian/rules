#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_install:
	# Install datadisk files to debian/tmp/usr/share/ishtaria/datadisks/gilgamesh/
	install -d debian/ishtaria-datadisk-gilgamesh/usr/share/ishtaria/datadisks/gilgamesh
	cp -a datadisk.yaml knowledge.yaml achievements.yaml sky_flyers.yaml places buildings trails rivers npcs dialogues quests lore music i18n \
		debian/ishtaria-datadisk-gilgamesh/usr/share/ishtaria/datadisks/gilgamesh/
	# Copy media but not voice (generated at build time)
	cp -a media debian/ishtaria-datadisk-gilgamesh/usr/share/ishtaria/datadisks/gilgamesh/
	# Copy voice config
	install -d debian/ishtaria-datadisk-gilgamesh/usr/share/ishtaria/datadisks/gilgamesh/voice
	cp -a voice/voices.yaml debian/ishtaria-datadisk-gilgamesh/usr/share/ishtaria/datadisks/gilgamesh/voice/

override_dh_install:
	# Generate spoken lines (Piper). Must not ship a silent disk.
	python3 tools/render_voices.py --out debian/ishtaria-datadisk-gilgamesh/usr/share/ishtaria/datadisks/gilgamesh/
	@voices=$$(find debian/ishtaria-datadisk-gilgamesh/usr/share/ishtaria/datadisks/gilgamesh/media/voice -name '*.ogg' 2>/dev/null | wc -l); \
	if [ "$$voices" -lt 1 ]; then \
		echo "debian/rules: no spoken lines under media/voice/ — refusing to package" >&2; \
		exit 1; \
	fi; \
	echo "debian/rules: $$voices spoken line files"

override_dh_builddeb:
	# Set permissions
	find debian/ishtaria-datadisk-gilgamesh -type f -exec chmod 644 {} \;
	find debian/ishtaria-datadisk-gilgamesh -type d -exec chmod 755 {} \;
	dh_builddeb

.PHONY: override_dh_auto_install override_dh_install override_dh_builddeb
